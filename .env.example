# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า:  cp .env.example .env

# ---------- Discord bot ----------
# Token ของบอท — Developer Portal > แท็บ Bot > Reset Token
DISCORD_TOKEN=

# Application ID — Developer Portal > General Information
CLIENT_ID=

# ID เซิร์ฟเวอร์ (คลิกขวาที่ชื่อเซิร์ฟ > Copy Server ID)
# ใส่แล้ว npm run deploy จะลงคำสั่งเฉพาะเซิร์ฟนี้ ขึ้นทันที
# เว้นว่าง = deploy แบบ global ใช้ได้ทุกเซิร์ฟ แต่รออัปเดต ~1 ชม.
GUILD_ID=

# ---------- Web dashboard ----------
# จำเป็น — ไม่ตั้ง dashboard จะไม่เปิดเลย  สร้างด้วย:  openssl rand -hex 32
SESSION_SECRET=

# ตั้ง 1 เมื่อมี HTTPS อยู่ข้างหน้า (Caddy/Cloudflare Tunnel ตาม DEPLOY.md)
# ทดสอบ local แบบ http ให้เป็น 0 ไม่งั้น browser ไม่ส่ง cookie (login วนลูป)
COOKIE_SECURE=0

# ---------- สถานะเครื่อง (webhook) ----------
# Discord webhook URL สำหรับส่งสถานะเครื่อง (CPU/RAM/อุณหภูมิ) เป็นระยะ
# สร้างที่ Server Settings > Integrations > Webhooks > New Webhook > Copy URL
# เว้นว่าง = ปิดฟีเจอร์นี้  ·  ปรับลิงก์เว็บ/ความถี่ได้ใน src/config.ts (config.status)
# STATUS_WEBHOOK_URL=

# Claude API key สำหรับ AI mod (ตรวจข้อความ toxic) — สร้างที่ https://platform.claude.com/settings/keys
# เว้นว่าง = AI mod ปล่อยข้อความผ่านทั้งหมด (บอทยังทำงานปกติ)
# ANTHROPIC_API_KEY=

# ---------- ตัวเลือกเสริม ----------
# path ไฟล์ SQLite (ค่าเริ่มต้น: data/bot.db) — ปกติไม่ต้องตั้ง
# BOT_DB_PATH=
