{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  // หน้าเว็บมี tsconfig ของตัวเอง (JSX + lib DOM) — ตรวจแยกด้วย npm run typecheck:ui
  "exclude": ["src/web/ui"]
}
