{
  "name": "discord-security-bot",
  "version": "0.1.0",
  "description": "A Discord security bot: anti-raid, anti-spam, auto-mod and audit logging.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "web": "tsx src/scripts/webOnly.ts",
    "user:add": "tsx src/scripts/userAdd.ts",
    "user:remove": "tsx src/scripts/userRemove.ts",
    "db:migrate": "tsx src/scripts/migrateJson.ts",
    "avatar:set": "tsx src/scripts/setAvatar.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.25",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
