{
  "name": "discord-security-bot",
  "version": "0.1.0",
  "description": "A Discord security bot: anti-raid, anti-spam, auto-mod and audit logging.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "web": "tsx src/scripts/webOnly.ts",
    "db:migrate": "tsx src/scripts/migrateJson.ts",
    "db:backup": "tsx src/scripts/backupDb.ts",
    "db:tag-partners": "tsx src/scripts/tagPartnerLogs.ts",
    "db:split-events": "tsx src/scripts/splitLogEvents.ts",
    "dev:session": "tsx src/scripts/devSession.ts",
    "db:seed-demo": "tsx src/scripts/seedDemo.ts",
    "avatar:set": "tsx src/scripts/setAvatar.ts",
    "build:ui": "vite build src/web/ui",
    "dev:ui": "vite src/web/ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/ui",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@napi-rs/canvas": "^1.0.0",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai-looped": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.25",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.2.1"
  }
}
